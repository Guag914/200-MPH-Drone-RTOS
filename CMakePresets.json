{
    "version": 3,
    "configurePresets": [
        {
            "name": "drone-rtos-debug",
            "displayName": "Drone RTOS Debug",
            "description": "Cross-compilation profile for ARM microcontroller",
            "binaryDir": "${sourceDir}/build-drone-rtos",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "cmake/gcc-arm-none-eabi.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "drone-rtos-debug",
            "configurePreset": "drone-rtos-debug"
        }
    ]
}